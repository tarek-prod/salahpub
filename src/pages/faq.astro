---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { site } from "../data/site";
import { withBase } from "../utils/urls";
---
<BaseLayout
  title="FAQ"
  description="Questions fréquentes sur les services publicitaires de SalahPub."
>
  <section class="mx-auto max-w-3xl px-4 py-16 md:py-20">
    <SectionTitle
      title="Questions fréquentes"
      subtitle="Vous ne trouvez pas votre réponse ? Contactez-nous, nous serons ravis d'échanger avec vous."
    />
    <div class="space-y-3">
      {site.faq.map((item) => (
        <details class="group rounded-2xl border border-brand-100 bg-white p-5 open:shadow-sm">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-brand-800 marker:hidden">
            {item.question}
            <span aria-hidden="true" class="shrink-0 text-xl text-brand-500 transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-4 leading-relaxed text-ink/75">{item.answer}</p>
        </details>
      ))}
    </div>
    <a href={withBase("/contact/")} class="mt-8 inline-flex font-semibold text-brand-700 hover:text-brand-500">
      Une autre question ? Contactez-nous <span aria-hidden="true" class="ml-1">→</span>
    </a>
  </section>
</BaseLayout>

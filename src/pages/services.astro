---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { site } from "../data/site";
---
<BaseLayout
  title="Nos services"
  description="Les services publicitaires de SalahPub : enseignes, lettres lumineuses, impression, décoration et marquage véhicules."
>
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <SectionTitle
      title="Nos services"
      subtitle="Des solutions de communication visuelle adaptées à votre activité, de la création à l'installation."
    />
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {site.services.map((service) => <ServiceCard service={service} />)}
    </div>
    <div class="mt-12 rounded-2xl bg-brand-50 p-6 sm:p-8">
      <h2 class="text-xl font-bold text-brand-800">Un besoin spécifique ?</h2>
      <p class="mt-2 max-w-2xl leading-relaxed text-ink/70">
        Chaque projet est différent. Contactez-nous pour échanger sur vos besoins et obtenir une proposition adaptée.
      </p>
      <a href="/contact" class="mt-5 inline-flex rounded-full bg-brand-600 px-5 py-3 font-semibold text-white hover:bg-brand-700">
        Demander un devis
      </a>
    </div>
  </section>
</BaseLayout>

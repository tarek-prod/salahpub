---
import BaseLayout from "../layouts/BaseLayout.astro";
import EngagementList from "../components/EngagementList.astro";
import Hero from "../components/Hero.astro";
import RealizationCard from "../components/RealizationCard.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { site } from "../data/site";
import { withBase } from "../utils/urls";
---
<BaseLayout title="Accueil">
  <Hero />

  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <SectionTitle
      title="Des solutions pour votre visibilité"
      subtitle="Une offre complète, de la conception à la pose, pour faire rayonner votre activité."
    />
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {site.services.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <section class="bg-brand-50/70">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <SectionTitle
        title="Nos engagements"
        subtitle="Un accompagnement attentif et un travail soigné à chaque étape de votre projet."
      />
      <EngagementList />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionTitle
        title="Quelques réalisations"
        subtitle="Découvrez des exemples de notre savoir-faire."
      />
      <a href={withBase("/realizations/")} class="mb-8 font-semibold text-brand-700 hover:text-brand-500">
        Toute la galerie <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {site.realizations.slice(0, 6).map((realization) => (
        <RealizationCard realization={realization} />
      ))}
    </div>
  </section>

  <section class="bg-brand-900 text-white">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-4 py-12 sm:flex-row sm:items-center">
      <div>
        <h2 class="text-2xl font-bold">Un projet en tête ?</h2>
        <p class="mt-2 text-white/70">Parlons ensemble de votre prochaine réalisation.</p>
      </div>
      <a href={withBase("/contact/")} class="rounded-full bg-brand-400 px-6 py-3 font-semibold text-white hover:bg-brand-300">
        Parlons de votre projet
      </a>
    </div>
  </section>
</BaseLayout>

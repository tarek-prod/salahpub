---
import { site } from "../data/site";

const phoneHref = site.identity.phone.replace(/[^\d+]/g, "");
---
<header class="sticky top-0 z-50 border-b border-brand-100 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4">
    <a href="/" class="shrink-0 text-xl font-extrabold tracking-tight text-brand-800" aria-label="SalahPub, accueil">
      Salah<span class="text-brand-500">Pub</span>
    </a>

    <nav aria-label="Navigation principale" class="hidden items-center gap-5 text-sm font-medium lg:flex">
      {site.navigation.map((item) => (
        <a href={item.href} class="text-ink/75 transition-colors hover:text-brand-600">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        href={`tel:${phoneHref}`}
        class="rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
      >
        <span class="hidden sm:inline">{site.identity.phone}</span>
        <span class="sm:hidden">Appeler</span>
      </a>
      <details class="relative lg:hidden">
        <summary
          aria-label="Ouvrir le menu"
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-brand-200 text-brand-800 marker:hidden"
        >
          <span aria-hidden="true" class="text-xl leading-none">☰</span>
        </summary>
        <nav
          aria-label="Navigation mobile"
          class="absolute right-0 top-12 z-50 grid min-w-56 gap-1 rounded-2xl border border-brand-100 bg-white p-2 text-sm font-medium shadow-xl"
        >
          {site.navigation.map((item) => (
            <a href={item.href} class="rounded-xl px-4 py-3 text-ink/80 hover:bg-brand-50 hover:text-brand-700">
              {item.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

---
import type { Service } from "../data/site";
import { withBase } from "../utils/urls";

interface Props {
  service: Service;
}

const { service } = Astro.props;
---
<a
  href={withBase("/services/")}
  class="group block rounded-2xl border border-brand-100 bg-white p-6 transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-lg"
>
  <span
    aria-hidden="true"
    class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-2xl font-semibold text-brand-600"
  >
    {service.icon}
  </span>
  <h3 class="mt-5 font-bold text-brand-800 group-hover:text-brand-600">{service.title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-ink/70">{service.description}</p>
</a>
